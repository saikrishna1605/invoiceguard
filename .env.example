# Optional: if set, Extract Agent uses Claude for real extraction.
# If unset, the agent falls back to a deterministic regex-based extractor
# so the demo still works end-to-end without an API key.
ANTHROPIC_API_KEY=

# Anomaly threshold: flag invoices this many times above a vendor's
# historical average amount.
ANOMALY_MULTIPLIER=2.5

# Optional: high-risk invoices push to Slack if set (incoming webhook URL).
SLACK_WEBHOOK_URL=

# Optional: high-risk invoices push to email if SMTP_HOST + ALERT_EMAIL_TO
# are both set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=invoiceguard@example.com
ALERT_EMAIL_TO=

DATABASE_URL=sqlite:///./invoiceguard.db
